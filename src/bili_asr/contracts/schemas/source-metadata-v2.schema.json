{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuperCatQR/bilibili-asr-archive/docs/contracts/source-metadata-v2.schema.json",
  "title": "Frozen Source Metadata Version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "platform",
    "externalVideoId",
    "partIndex",
    "title",
    "creatorId",
    "creatorName",
    "pubdateUnix",
    "sourcePublishedAt",
    "metadataObservedAt",
    "description",
    "coverUrl",
    "categoryId",
    "tags",
    "aid",
    "partTitle",
    "durationMs",
    "observationBindings"
  ],
  "properties": {
    "version": {
      "const": "source-metadata-v2"
    },
    "platform": {
      "enum": [
        "bilibili",
        "youtube"
      ]
    },
    "externalVideoId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "partIndex": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "creatorId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "creatorName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "pubdateUnix": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "sourcePublishedAt": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "metadataObservedAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 65536
    },
    "coverUrl": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "pattern": "^https://(?:(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+hdslb\\.com|i[1-4]?\\.ytimg\\.com)(?::443)?(?:/[^\\s\\\\?#]*)?$"
    },
    "categoryId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "tags": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "aid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "partTitle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "durationMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "observationBindings": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observationId",
          "payloadSha256",
          "envelopeSha256"
        ],
        "properties": {
          "observationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "payloadSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "envelopeSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "description": "Version 1 remains frozen. Version 2 additionally allows registered public YouTube thumbnail hosts and freezes exact original-response receipts. No private response is embedded. Application validation enforces platform-specific cover hosts and receipt identities."
}
