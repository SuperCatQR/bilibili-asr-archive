{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private editorial source lineage comparison version 1",
  "type": "object",
  "required": [
    "schema",
    "input_id",
    "revision_id",
    "snapshot_sha256",
    "blocks_sha256",
    "structure_status",
    "semantic_status",
    "review_required",
    "reviewer_kind",
    "reviewer",
    "human_review_status",
    "time_range_basis",
    "paragraphs",
    "repeated_draft_groups"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "editorial-source-lineage/v1"
    },
    "input_id": {
      "$ref": "#/$defs/sha256"
    },
    "revision_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "blocks_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "structure_status": {
      "const": "passed"
    },
    "semantic_status": {
      "const": "unverified"
    },
    "review_required": {
      "const": true
    },
    "reviewer_kind": {
      "type": "null"
    },
    "reviewer": {
      "type": "null"
    },
    "human_review_status": {
      "const": "not_reviewed"
    },
    "time_range_basis": {
      "const": "declared_sources_not_verified_semantic_support"
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph_index",
          "chunk_ids",
          "declared_source_range",
          "source_segments",
          "original_text",
          "draft_text",
          "source_text_sha256",
          "draft_text_sha256",
          "comparison_only_adjacent_source_segments",
          "comparison_only_adjacent_paragraph_indices",
          "same_draft_group",
          "cross_chunk_comparison",
          "semantic_status",
          "review_required"
        ],
        "properties": {
          "paragraph_index": {
            "type": "integer",
            "minimum": 0
          },
          "chunk_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "declared_source_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_ids",
              "start_ms",
              "end_ms",
              "semantic_support"
            ],
            "properties": {
              "segment_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0
              },
              "semantic_support": {
                "const": "unverified"
              }
            }
          },
          "source_segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/sourceSegment"
            }
          },
          "original_text": {
            "type": "string"
          },
          "draft_text": {
            "type": "string"
          },
          "source_text_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "draft_text_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "comparison_only_adjacent_source_segments": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/sourceSegment"
            }
          },
          "comparison_only_adjacent_paragraph_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": 2
          },
          "same_draft_group": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "cross_chunk_comparison": {
            "type": "boolean"
          },
          "semantic_status": {
            "const": "unverified"
          },
          "review_required": {
            "const": true
          }
        }
      }
    },
    "repeated_draft_groups": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceSegment": {
      "type": "object",
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "type": "string"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
