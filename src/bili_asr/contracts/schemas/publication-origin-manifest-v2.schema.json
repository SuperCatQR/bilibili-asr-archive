{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Origin Export Manifest Version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manuscriptType", "contractProfile", "snapshotId", "files"],
  "properties": {
    "schemaVersion": {"const": 2},
    "manuscriptType": {"enum": ["publication-export", "publication-draft-export"]},
    "contractProfile": {"const": "universal-origin-v1"},
    "snapshotId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "allOf": [
        {"contains": {"properties": {"path": {"const": "catalog.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "origins.json"}}}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "allOf": [{
    "if": {"properties": {"manuscriptType": {"const": "publication-export"}}},
    "then": {"properties": {"files": {"items": {"properties": {
      "path": {"pattern": "^(catalog\\.json|origins\\.json|series\\.json|articles/part-[1-9][0-9]*/(publish|review)\\.md)$"}
    }}}}},
    "else": {"properties": {"files": {"items": {"properties": {
      "path": {"pattern": "^(catalog\\.json|origins\\.json|series\\.json|drafts/edition-[0-9a-f]{32}/(preview|review)\\.md)$"}
    }}}}}
  }]
}
