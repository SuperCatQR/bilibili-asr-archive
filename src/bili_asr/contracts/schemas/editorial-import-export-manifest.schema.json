{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Imported Editorial Export Manifest Version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manuscriptType",
    "snapshotId",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manuscriptType": {
      "const": "editorial-export"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "enum": [
              "ai-draft.md",
              "review.md",
              "edition.md",
              "edition.json",
              "review.json",
              "differences/ai.patch",
              "differences/parent.patch",
              "import-origin.json",
              "preserved-body.md",
              "differences/preserved.patch"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
