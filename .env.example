# bili-asr 环境变量模板（示例文件，可提交；真实凭据放 .env，已 gitignore）
#
# 用法：
#   cp .env.example .env          # 复制后把值填进 .env
#   set -a; source .env; set +a   # 在启动 bili-asr 的同一个 shell 里导出（代码不自动加载 .env）
#
# 注意：值请用单引号包裹 —— SESSDATA 内含 * 与 %2C，不加引号会被 shell 展开或截断。
#
# SESSDATA 获取：浏览器登录 B 站 → F12 → Application → Cookies → bilibili.com
#   → 复制 SESSDATA 的值（形如 xxxx%2Cxxxx%2Cxxxx*Cj；一整串值，不要带引号）。
# 生命周期：Cookie 会过期，过期后在 .env 里重抄一次即可。
#

# —— 凭据（可选；不填则匿名访问：匿名元数据采集被上游风控拦截时以有界 rate_limited 结束，
#    其他上游失败为有界 response_error；口径与 README、docs/metadata-storage.md 一致）——
# BILI_SESSDATA='你的_SESSDATA_Cookie_值'

# —— HTTP 代理（可选；直连 B 站不通或被风控时需要）——
# 为什么要显式配置：pinned 的 bilibili-api-python(17.4.2) CurlCFFIClient 建会话时写死
#   proxies={"all": ""}，库自身会绕过 HTTPS_PROXY / ALL_PROXY 等环境变量；网关在构造请求前
#   自己解析一次代理（下面的顺序包含这些环境变量），所以它们依然有效，只是必须由网关应用。
# 解析顺序（先非空者胜，空值视为未设置；均未设置时不强制代理，保持库默认行为）：
#   构造参数 → BILI_HTTP_PROXY → HTTPS_PROXY/https_proxy → ALL_PROXY/all_proxy
# 代理 URL 属配置而非凭据，不会写入 CLI 输出、日志或数据库。
# 默认：不设置（不强制代理）。示例值（非默认）：
# BILI_HTTP_PROXY=http://127.0.0.1:7890

# —— ASR 模型（可选；两个 checkpoint 都在本地加载，运行时不联网；
#    权重位置与获取方式见 README《Where the ASR checkpoints live》）——
# 解码器（只给文字）。默认 Qwen/Qwen3-ASR-1.7B-hf：
# BILI_ASR_MODEL=./models/Qwen3-ASR-1.7B-hf
# 对齐器（逐字时间戳）。默认 Qwen/Qwen3-ForcedAligner-0.6B-hf：
# BILI_ASR_ALIGNER_MODEL=./models/Qwen3-ForcedAligner-0.6B-hf
# 声明的 hub 身份：模型值是路径时，归档不会把路径写进前言，用它声明真实身份
# BILI_ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B-hf
# BILI_ASR_MODEL_REVISION=<pinned-revision>
# 切块窗口（秒），默认 180；解码与对齐共用，切在低能量边界上
# BILI_ASR_CHUNK_SECONDS=180
# 设备，默认 cuda；CPU 模式：
# BILI_ASR_DEVICE=cpu
# 声明的语言，默认 Chinese；归档只记录操作者的声明，不做语言检测
# BILI_ASR_LANGUAGE=Chinese
# 追加到内置词表的术语（逗号分隔）
# BILI_ASR_HOTWORDS=扬弃,自在,变易

# —— 音频保留（可选；默认 0 = archived 后删除音频以省磁盘，设为 1 = 保留音频供未来重跑）——
# BILI_KEEP_AUDIO=0
