# Copy to .env and export it in the shell that runs bili-asr.
# The CLI does not load .env automatically.

# Optional Bilibili credential and proxy.
# BILI_SESSDATA='your-sessdata'
# BILI_HTTP_PROXY=http://127.0.0.1:7890

# Optional DeepSeek proofreading workflow.
# DEEPSEEK_API_KEY='your-deepseek-api-key'

# Optional product locations and audio retention.
# BILI_ARTIFACT_ROOT=./archive
# BILI_KEEP_AUDIO=1

# Local ASR checkpoints and runtime settings.
# BILI_ASR_MODEL=./models/Qwen3-ASR-1.7B-hf
# BILI_ASR_ALIGNER_MODEL=./models/Qwen3-ForcedAligner-0.6B-hf
# BILI_ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B-hf
# BILI_ASR_MODEL_REVISION=<pinned-revision>
# BILI_ASR_DEVICE=cuda
# BILI_ASR_LANGUAGE=Chinese
# BILI_ASR_CHUNK_SECONDS=180
# BILI_ASR_HOTWORDS=term1,term2

# ASR runs even when AI/CC subtitles exist by default. Use the CLI switch
# --no-asr-with-subtitles for a subtitle-only run.
