  "cards": [
    {
      "dot": "emerald",
      "title": "失败维度不可相加",
      "items": [
        "当前failed jobs和历史failed attempts分别计数，成功重试不抹去历史。",
        "窗口按finished_at使用半开范围；缺少完整外部控制时重试资格与hold数量为未知。"
      ]
    },
    {
      "dot": "rose",
      "title": "自动重试与修复边界",
      "items": [
        "仅已知短暂网络、408/429和5xx进入有限预算与退避。",
        "402/认证、来源重复、校对契约与出版契约失败默认停止自动重试；来源修复保留原失败。",
        "手动override需要准确单job与理由；不得清除hold或绕过活跃替代任务。"
      ]
    },
    {
      "dot": "amber",
      "title": "提交与外部控制",
      "items": [
        "实际重排在SQLite写锁内复验已检查任务；控制摘要在检查后与提交前再核对。",
        "外部控制始终只读；文件写入者需串行协调，摘要检查不是跨介质原子事务。",
        "后续worker另行claim；重排保留全部attempts和冻结输入，不改写时间轴或模型证据。"
      ]
    }
  ]
