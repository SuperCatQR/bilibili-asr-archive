  "cards": [
    {
      "dot": "cyan",
      "title": "执行与所有权",
      "items": [
        "本地 Python CLI 与 SQLite；图中各 SQLite 节点是同一 archive.db 的逻辑表组。",
        "控制仓库拥有 lease/attempt；handler 在锁外执行网络与推理，短保护事务提交结果。",
        "ASR 只依赖 audio；字幕独立；AI 校对可选；原始 bundle 与人工 publication 两个域独立。"
      ]
    },
    {
      "dot": "emerald",
      "title": "消费与恢复",
      "items": [
        "FTS、公开/预览/私有快照均为消费产物；读者站点属于独立仓库。",
        "完整 ZIP 保留数据库、音频、bundle、AI 双稿与全部历史 release；restore 恢复中断 job。",
        "16 个分流程时序图与源码、命令、SQL 清单补充全部条件分支和保留工具边界。"
      ]
    },
    {
      "dot": "rose",
      "title": "提交边界",
      "items": [
        "取消与 lease guard 串行保护权威写入；不能立即撤销在途 HTTP 或 GPU 请求。",
        "SQLite 与文件系统无跨介质事务；完成 marker、哈希与显式重排负责识别和恢复。",
        "source tags 更新不改写旧 edition；精确 approved/hash/CAS 后显式 publish 才切换公开 head。"
      ]
    }
  ]
}
