  "cards": [
    {
      "dot": "cyan",
      "title": "执行与所有权",
      "items": [
        "本地 Python CLI 与 SQLite；图中各 SQLite 节点是同一 archive.db 的逻辑表组。",
        "WorkflowApplication 组装运行用例；纯 JobSpec 规划与持久写入分离，profile/jobs 在同一事务保存。",
        "ASR 只依赖 audio；字幕独立；AI 校对可选；原始 bundle 与人工 publication 两个域独立。"
      ]
    },
    {
      "dot": "emerald",
      "title": "消费与恢复",
      "items": [
        "preferred 当前转录与 published 发布身份分离；批量投影、coverage 和 export 描述同一已发布内容。",
        "完整 ZIP 保留数据库、音频、bundle、AI 双稿与全部历史 release；restore 恢复中断 job。",
        "17 个分流程时序图与源码、命令、SQL 清单补充全部条件分支和保留工具边界。"
      ]
    },
    {
      "dot": "rose",
      "title": "提交边界",
      "items": [
        "取消与 lease guard 串行保护权威写入；不能立即撤销在途 HTTP 或 GPU 请求。",
        "SQLite 与文件系统无跨介质事务；完成 marker、哈希与显式重排负责识别和恢复。",
        "source tags 更新不改写旧 edition；精确 approved/hash/CAS 后显式 publish 才切换公开 head。"
      ]
    },
    {
      "dot": "amber",
      "title": "迁移预检边界",
      "items": [
        "archive migration-preflight 持有源维护独占锁，以冻结 Bilibili v1 契约只读检查旧库与全部历史产物。",
        "停止所有 writer 并完成 checkpoint 是前置条件；不初始化当前 schema，不创建目标，不恢复任务或执行转换。",
        "表指纹、文件摘要、遮蔽/排除项、历史审核及 release 校验和变化检测见时序 17。"
      ]
    },
    {
      "dot": "violet",
      "title": "共享策略与访问边界",
      "items": [
        "transcript_selection 统一 CC/AI/ASR、语言 family、精确代码与版本偏好；来源端口只适配 ID/观察，不决定 ASR 策略。",
        "ArchiveSession READ/WRITE 无初始化 DDL，BOOTSTRAP 显式建库；程序化连接持有维护 lease 到 close。",
        "JobCommitGuard 保护相同 owner/attempt/lease；payload 在副作用前校验，旧无版本 JSON 按 v1 读取。",
        "FTS 固定 transcript 上界、每页最多 500 segments；cursor 同批提交，MD 回退也按键分页。"
      ]
    }
  ]
}
