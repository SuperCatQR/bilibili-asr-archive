  "cards": [
    {
      "dot": "cyan",
      "title": "范围与证据",
      "items": [
        "图聚焦当前 CLI 的 SQLite workflow 主链、外部采集、派生文件与查询投影。",
        "所有 archive.db 节点是同一 SQLite 文件中的逻辑表组；媒体与发布 bundle 是文件产物。",
        "图中 revision 固定到合并提交；边和组件的源码引用用于追溯当前实现。"
      ]
    },
    {
      "dot": "emerald",
      "title": "单一控制平面",
      "items": [
        "WorkflowRepository 负责计划、依赖、租约、attempt 与 retry；WorkflowExecutor 在 CLI 调用中领取并执行任务。",
        "ASR job 固定 profile 和参考 transcript ID，并读取对应 audio prerequisite 的结果。",
        "发布前后及文件替换边界校验租约，过期 worker 不能提交新的发布事实。"
      ]
    },
    {
      "dot": "cyan",
      "title": "采集与转录",
      "items": [
        "fetch-meta 通过 Bilibili gateway 有界采集 user / video / part / tag 事实并写入 SQLite。",
        "字幕与音频为独立 producer；ASR 依赖 audio 成功结果，不依赖字幕 job 成败。",
        "字幕与 ASR 都追加 transcript versions 和 segments，保留来源和历史版本。"
      ]
    },
    {
      "dot": "violet",
      "title": "处理与发布",
      "items": [
        "本地 ASR 使用 profile 指定的模型与设备；解码、对齐、分块由 ASR runner 执行。",
        "发布 handler 选择当前优选 transcript，archive writer 写完整 SRT / TXT / Markdown / raw bundle。",
        "AI 校对将固定输入、模型调用、分块结果和修订写入 editorial SQLite 表；render 只读取已保存修订。"
      ]
    },
    {
      "dot": "amber",
      "title": "查询面",
      "items": [
        "status 与 runs 直接读 SQLite；coverage、export、verify 通过 workflow projection 得到统一状态。",
        "search-index 构建 SQLite FTS5；search 查询 transcript 文本并可补入已发布 Markdown。",
        "读命令不创建缺失的 archive.db；coverage strict 才将诊断提升为失败退出码。"
      ]
    }
  ]
}
