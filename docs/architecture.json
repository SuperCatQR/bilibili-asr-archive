  "cards": [
    {
      "dot": "cyan",
      "title": "控制与提交",
      "items": [
        "SQLite 是生产事实权威；所有逻辑表组属于同一 archive.db。",
        "父进程持有租约与提交权限；GPU 不访问数据库。网络、推理和重哈希在短事务外。"
      ]
    },
    {
      "dot": "emerald",
      "title": "副本与消费",
      "items": [
        "生产完成、驻留、外部可用和本地 readiness 分开报告；外置不重置任务。",
        "在线扩展和策略须显式启用；消费 pin、空间预留和精确恢复在 claim 前。"
      ]
    },
    {
      "dot": "rose",
      "title": "版本与恢复",
      "items": [
        "输入/模板 v1/v2、bundle v2/v3 与导出按实际保存版本分派；不重写历史身份。",
        "upgrade 在新目标转换；完整 snapshot 自包含，reference 需要外部依赖和执行权交接。"
      ]
    },
    {
      "dot": "amber",
      "title": "来源元数据与旧数据回填",
      "items": [
        "通用 JSON/CSV 投影读取当前数据库；bundle.md 与 source-metadata.json 固定发布时来源快照，两者可以不同。",
        "旧包显式 preserve-transcript：绑定原 publication 与转录哈希，核验旧 marker 并保留完整 artifact group，再写 v3。",
        "旧文章 description 补充创建 pending-review 子版，保留原正文与旧 release；需重新审核和显式发布。",
        "简介补充使用 universal-origin-v2；配套 Reader 提交 4a5933c743a05d067ce719b63c04cb9dfbc5ab6c 已支持 v1/v2，部署与回填独立。"
      ]
    },
    {
      "dot": "cyan",
      "title": "失败维护与模型调用预算",
      "items": [
        "retry-maintenance 是显式周期服务；worker 存活、维护成功与锁竞争分别观测。",
        "沿用已有 holds/累计 ledger；范围、allowlist、backoff 和准确 attempt CAS 限制重排，先扣额后派发。",
        "模型逐块 physical budget 在 HTTP 前持久预留，成功块/有效响应重用，耗尽停止；legacy 请求保持。"
      ]
    },
    {
      "dot": "rose",
      "title": "失败政策与外部控制",
      "items": [
        "jobs、attempts、失败窗口、holds 与替代任务分别统计；状态和 dry-run 只读。",
        "自动恢复仅允许明确 transient；控制未知、hold、预算、退避和替代链阻止重排。",
        "错误码与安全 stage/reason 在生产边界保存；旧输入、attempt 和原响应证据保留。"
      ]
    }
  ]
}
