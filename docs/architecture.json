  "cards": [
    {
      "dot": "cyan",
      "title": "范围与证据",
      "items": [
        "所有 archive.db 节点属于同一 SQLite 文件中的逻辑表组；音频、bundle 和快照是文件产物。",
        "源码引用固定到功能代码提交；阅读内容快照供外部前端消费，仓库没有阅读前端源码。"
      ]
    },
    {
      "dot": "emerald",
      "title": "选择与控制",
      "items": [
        "BVID / part ID 先全集验证，再幂等规划；ASR 只依赖音频成功，不依赖字幕。",
        "取消 queued/running 为 cancelled，精确 attempt 防止旧 worker 提交；取消不级联且不被 retry 恢复。",
        "网络与推理在事务外运行；权威结果在 BEGIN IMMEDIATE 内检查 lease 并提交。"
      ]
    },
    {
      "dot": "cyan",
      "title": "采集与音频",
      "items": [
        "fetch-meta 持久保存分页事实与恢复游标；字幕和 ASR 追加不可变转录。",
        "音频复用或独立暂存，probe / hash 在锁外，最终替换与对象登记在 guard 内。",
        "workflow 写入 archive root，保留真实 M4A / FLAC 后缀；当前 handler 没有自动音频回收。"
      ]
    },
    {
      "dot": "violet",
      "title": "发布与校对",
      "items": [
        "编码、摘要与暂存先完成；五文件、v2 marker 与 publication 登记共享写锁，失败清理在回滚前。",
        "校对冻结输入、审计调用、保存校验块与完整修订；render 只读已保存修订，不调用模型。",
        "SQLite 与文件系统没有跨介质原子事务；verify 与显式重新发布负责检测及恢复。"
      ]
    },
    {
      "dot": "amber",
      "title": "搜索与投影",
      "items": [
        "metadata 直接只读查询当前标题、简介和标签，不要求 FTS 或产物；transcripts 保持 FTS 查询。",
        "all 先元数据后转录，共用 limit；日期为 UTC 日，JSON stdout 为数组，诊断走 stderr。",
        "coverage / export / verify 共享读取投影；坏发布仍保留为可报告缺陷。"
      ]
    },
    {
      "dot": "amber",
      "title": "阅读内容发布",
      "items": [
        "reading-export 只读 SQLite，校验已登记 Markdown 摘要，写 catalog / articles / reviews 快照。",
        "reading-review / reading-edit 显式采纳审核与人工 edition；原始转录及 AI 修订不被覆写。"
      ]
    }
  ]
}
