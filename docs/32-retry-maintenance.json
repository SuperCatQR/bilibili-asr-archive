  "cards": [
    {
      "dot": "rose",
      "title": "失败边界",
      "items": [
        "holds / unknown error / quality / timestamps / payment / cancelled 不重排",
        "缺失或未知状态 fail closed，绝不新建空账本"
      ]
    },
    {
      "dot": "amber",
      "title": "跨文件与 SQLite 的保守恢复",
      "items": [
        "先持久扣减，崩溃只损失额度，不获得免费 retry",
        "同 attempt 的不确定预留需人工复验；重启不重置累计预算"
      ]
    },
    {
      "dot": "emerald",
      "title": "工作流与维护分离",
      "items": [
        "timer 需要显式启用，不推进生产 scope",
        "常规 worker 保活、维护成功和锁竞争分别观测"
      ]
    },
    {
      "dot": "cyan",
      "title": "统一恢复准入",
      "items": [
        "status / explain / workflow retry / maintenance 共用 failure_policy、decide_retry 与 editorial_retry_facts。",
        "维护策略只进一步收紧 scope、allowlist、ledger 和 backoff；holds、活动替代与冻结物理预算仍优先。"
      ]
    }
  ]
