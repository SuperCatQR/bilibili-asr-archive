{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuperCatQR/bilibili-asr-archive/docs/contracts/archive-task-state-backup-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {"runtime_policy": ["runtime_exclusions"], "runtime_exclusions": ["runtime_policy"]},
  "required": [
    "format",
    "profile",
    "container",
    "database_contract",
    "runtime_contract",
    "producer_version",
    "source",
    "files",
    "tables",
    "media_dependencies",
    "inactive_archive",
    "media_self_contained",
    "restore_policy",
    "no_external_control_state",
    "backup_job_state",
    "observation",
    "created_at",
    "content_id",
    "media_policy"
  ],
  "properties": {
    "format": {
      "const": "archive-task-state-backup/v2"
    },
    "profile": {
      "const": "task-state"
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compression",
        "encryption"
      ],
      "properties": {
        "compression": {
          "const": "stored"
        },
        "encryption": {
          "type": "null"
        }
      }
    },
    "database_contract": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_contract": {
      "enum": [
        "bilibili-v1",
        "universal-v2"
      ]
    },
    "runtime_policy": {"const": "archive-runtime-v1"},
    "runtime_exclusions": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "category", "state", "count"], "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "category": {"enum": ["runtime-fence", "asr-input-reservation", "runtime-export-lock"]},
        "state": {"type": "string", "minLength": 1, "maxLength": 128},
        "count": {"type": "integer", "minimum": 0},
        "base": {"type": "string", "minLength": 1, "maxLength": 4096}
      }}
    },
    "producer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "database_schema_sha256"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "database_schema_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "columns",
          "row_count",
          "sha256",
          "includes_rowid"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "includes_rowid": {
            "type": "boolean"
          }
        }
      }
    },
    "media_dependencies": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256",
              "available",
              "kind"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "available": {
                "const": true
              },
              "kind": {
                "const": "audio-reference"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256",
              "available",
              "kind",
              "verification",
              "replicas"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "available": {
                "const": false
              },
              "kind": {
                "const": "audio-reference"
              },
              "verification": {
                "const": "sha256-container-and-original-member/v1"
              },
              "replicas": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "replica_id",
                    "target_id",
                    "relative_key",
                    "package_id",
                    "member_key",
                    "generation",
                    "verified_sha256",
                    "verified_byte_size",
                    "verified_at",
                    "observed_at",
                    "presence",
                    "target_kind",
                    "package_sha256",
                    "package_byte_size",
                    "manifest_sha256",
                    "backend",
                    "instance_id"
                  ],
                  "properties": {
                    "replica_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "target_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,255}$"
                    },
                    "relative_key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "package_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "member_key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "verified_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "verified_byte_size": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "verified_at": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_at": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "presence": {
                      "const": "present"
                    },
                    "target_kind": {
                      "const": "directory"
                    },
                    "package_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "package_byte_size": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "manifest_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "backend": {
                      "enum": [
                        "directory/v1",
                        "ssh-directory/v1"
                      ]
                    },
                    "instance_id": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{32}$",
                          "minLength": 32,
                          "maxLength": 32
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "inactive_archive": {
      "const": true
    },
    "media_self_contained": {
      "const": false
    },
    "restore_policy": {
      "const": "read-only-evidence-never-start-workers/v1"
    },
    "no_external_control_state": {
      "type": "boolean"
    },
    "backup_job_state": {
      "type": [
        "object",
        "null"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "started_at",
        "finished_at",
        "sqlite_snapshot_sha256",
        "component_versions",
        "atomic_cross_components"
      ],
      "properties": {
        "protocol": {
          "const": "sqlite-read-transaction-and-stable-components/v1"
        },
        "started_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "finished_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sqlite_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "component_versions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256",
              "source_path",
              "kind",
              "lock_path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "source_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "kind": {
                "enum": [
                  "retry-control/v1",
                  "retry-control/v2",
                  "backup-job-state/v1"
                ]
              },
              "lock_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "atomic_cross_components": {
          "const": false
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "content_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "media_policy": {
      "const": "verified-references/v1"
    }
  }
}
