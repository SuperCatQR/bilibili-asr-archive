{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuperCatQR/bilibili-asr-archive/docs/contracts/source-metadata-v1.schema.json",
  "title": "Frozen Source Metadata Version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "platform",
    "externalVideoId",
    "partIndex",
    "title",
    "creatorId",
    "creatorName",
    "pubdateUnix",
    "sourcePublishedAt",
    "metadataObservedAt",
    "description",
    "coverUrl",
    "categoryId",
    "tags",
    "aid",
    "partTitle",
    "durationMs"
  ],
  "properties": {
    "version": {
      "const": "source-metadata-v1"
    },
    "platform": {
      "enum": [
        "bilibili",
        "youtube"
      ]
    },
    "externalVideoId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "partIndex": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "creatorId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "creatorName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "pubdateUnix": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "sourcePublishedAt": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "metadataObservedAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 65536
    },
    "coverUrl": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+hdslb\\.com(?::443)?(?:/[^\\s\\\\?#]*)?$"
    },
    "categoryId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "tags": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "aid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "partTitle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "durationMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9223372036854776000
    }
  },
  "description": "Application validation additionally rejects control/surrogate text, validates provider identity, and verifies sourcePublishedAt from pubdateUnix. Zero or unrepresentable source time renders null."
}
