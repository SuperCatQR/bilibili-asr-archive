{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuperCatQR/bilibili-asr-archive/docs/contracts/ssh-directory-v1.schema.json",
  "title": "Linux OpenSSH Python 3 directory backend binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["backend", "target_id", "instance_id", "host", "root"],
  "properties": {
    "backend": {"const": "ssh-directory/v1"},
    "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "minLength": 1, "maxLength": 128},
    "instance_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]{32}$"}]},
    "host": {"type": "string", "minLength": 1, "maxLength": 253},
    "root": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/"},
    "username": {"type": "string", "minLength": 1, "maxLength": 128},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "password_env": {"type": ["string", "null"], "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "minLength": 1, "maxLength": 128},
    "key_filename": {"type": ["string", "null"], "minLength": 1},
    "known_hosts": {"type": ["string", "null"], "minLength": 1},
    "python_executable": {"type": "string", "minLength": 1, "maxLength": 4096},
    "timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "max_bytes_per_second": {"type": ["integer", "null"], "minimum": 1}
  }
}
