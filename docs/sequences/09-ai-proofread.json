  "cards": [
    {
      "dot": "cyan",
      "title": "边界与恢复",
      "items": [
        "build_input 在事务外构建冻结内容；显式请求的 store_input、两个任务和依赖边由应用层共事务保存，失败全部回滚。自动链的 store_input 与 job-input 绑定同样共用一次保护事务。",
        "Workflow 与 EditorialRepository 注入同一 JobCommitGuard；准确 attempt/owner/lease 在短写事务两端校验，不再各自实现租约保护逻辑。",
        "来源覆盖证明结构追溯，不能证明模型语义保真；数字、专名、否定、立场仍需人工审核。供应商已收请求而本地未存时，retry 可能重复计费。",
        "canonical_json 是共享纯序列化契约；editorial.canonical/digest 保留兼容导出，持久 JSON、digest 和既有 schema 未改变。"
      ]
    },
    {
      "dot": "slate",
      "title": "完整条件与操作",
      "items": [
        "m1：alt 显式 workflow proofread；WRITE Session 下选择当前最新 ASR 或精确 base ID；可显式参考 ID/no-reference",
        "m2：alt 显式 workflow proofread；build_input 在事务外；应用层进入共享短写事务",
        "m3：alt 显式 workflow proofread；store_input 与 enqueue_editorial 原子保存输入、两个任务和 proofread→render 依赖",
        "m4：else plan --proofread 自动链；解码版本化 payload；使用精确 ASR prerequisite 成功结果；重试已有 input_id 直接读取",
        "m5：else plan --proofread 自动链；锁外 build_input；保护事务内 store_input 与 job-input 绑定一起提交",
        "m6：else plan --proofread 自动链；冻结转录、metadata、配置、system prompt、引用和块；canonical_json 计算固定 digest",
        "m7：共同步骤；检查精确 lease 并加载不可变输入",
        "m8：loop 每个冻结块；读取 chunk checkpoint",
        "m9：loop 每个冻结块 → alt 已完成块；复用已验证块并跳过远端调用",
        "m10：loop 每个冻结块 → else 未完成块；renew 至 API timeout+300；begin_call 在共享提交保护下绑定准确 running attempt",
        "m11：loop 每个冻结块 → else 未完成块；保存 request_json；不保存密钥",
        "m12：loop 每个冻结块 → else 未完成块；锁外发送冻结配置；thinking/top_p/max_tokens；无隐式 HTTP 重试",
        "m13：loop 每个冻结块 → else 未完成块；返回真实 envelope、usage/model；finish_reason 必须 stop",
        "m14：loop 每个冻结块 → else 未完成块；finish_call 保留真实 envelope 或有界错误；取消后审计仍可落库",
        "m15：loop 每个冻结块 → else 未完成块；save_chunk；事务进入与退出均检查准确 owner、attempt 和 lease",
        "m16：loop 每个冻结块 → else 未完成块；保存有效 chunk_results；取消或过期 lease 则拒绝并回滚",
        "m17：loop 每个冻结块 → else 未完成块 → opt 请求或结构校验失败；已完成块保留；executor fail；显式 retry 从未完成块继续",
        "m18：共同步骤；commit_revision 收集全部块并验证完整 segment 顺序",
        "m19：共同步骤；input_id+blocks 固定 digest；needs-review 或 ai-unreviewed；短保护事务提交",
        "m20：共同步骤；返回 input_id/revision_id；render_document 仅在 proofread succeeded 后可领取"
      ]
    },
    {
      "dot": "amber",
      "title": "参与者内部动作",
      "items": [
        "校对 handler：严格 JSON；恰好一次连续有序覆盖；拒绝未知/只读来源和非段落正文"
      ]
    }
