  "cards": [
    {
      "dot": "cyan",
      "title": "条件与提交边界",
      "items": [
        "approved/rejected 是该 review 的终态；修改内容创建新 edition 和新的 pending-review。",
        "publication_edition_reviews 保存当前审核状态，publication_events 追加审核变化证据；不能称每次审核都是新 review 行。",
        "A 发布后创建/审核/批准 B 都保持 A；B 明确 publish 后才替换；预览出口也不会恢复旧 release。"
      ]
    },
    {
      "dot": "slate",
      "title": "阅读方法",
      "items": [
        "B 编号对应完整条件路径；互斥分支仅在条件成立时执行，opt 可选，loop 重复。",
        "HTML 将嵌套条件展开为连续区域；自调用保留在内部动作卡片。完整 Mermaid 与源码范围见同名 Markdown。"
      ]
    },
    {
      "dot": "amber",
      "title": "完整条件路径",
      "items": [
        "B01（m5–m6）：opt edit 或 sync-source-tags",
        "B02（m9）：alt 未批准或状态哈希不符",
        "B03（m10）：else approved 并显式 publish",
        "B04（m11–m12）：else approved 并显式 publish → alt edition 已有历史 release",
        "B05（m13–m17）：else approved 并显式 publish → else 首次发布该 edition",
        "B06（m18–m20）：opt withdraw"
      ]
    }
  ]
