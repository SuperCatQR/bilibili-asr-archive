  "cards": [
    {
      "dot": "cyan",
      "title": "条件与提交边界",
      "items": [
        "SESSDATA 是否存在与凭据是否有效是不同事实；秘密和瞬时签名 URL 不作为长期归档内容。",
        "原始标签只在 edition create 或显式 sync-source-tags 时冻结；抓取更新不改写既有 edition/release。",
        "page_retries 的退避由采集服务拥有；标签失败是可选数据失败，不把成功页变成失败页。"
      ]
    },
    {
      "dot": "slate",
      "title": "阅读方法",
      "items": [
        "B 编号对应完整条件路径；互斥分支仅在条件成立时执行，opt 可选，loop 重复。",
        "HTML 将嵌套条件展开为连续区域；自调用保留在内部动作卡片。完整 Mermaid 与源码范围见同名 Markdown。"
      ]
    },
    {
      "dot": "amber",
      "title": "完整条件路径",
      "items": [
        "B01（m3–m4）：loop 每页直到空页、上限或失败",
        "B02（m5–m6）：loop 每页直到空页、上限或失败 → opt 可重试的传输或限流错误",
        "B03（m7–m8）：loop 每页直到空页、上限或失败",
        "B04（m9–m13）：loop 每页直到空页、上限或失败 → alt 页面成功且非空",
        "B05（m14）：loop 每页直到空页、上限或失败 → else 空页",
        "B06（m15）：loop 每页直到空页、上限或失败 → else 页请求失败",
        "B07（m16）：loop 每页直到空页、上限或失败 → else 页请求失败 → opt skip-failed-page 且 failed",
        "B08（m19–m21）：opt 显式 fetch-tags"
      ]
    }
  ]
