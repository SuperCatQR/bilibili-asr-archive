  "cards": [
    {
      "dot": "cyan",
      "title": "边界与恢复",
      "items": [
        "MAINTENANCE 由统一 ArchiveSession 取得独占访问；普通查询、写入和心跳连接均持有共享访问直至 close。外部直接 SQLite writer 仍必须由操作者停止。",
        "artifact_inventory 统一路径、冲突、临时文件和有界流式 hash；artifacts 公开 BUNDLE_BASENAMES/BUNDLE_MARKER_NAME/owns_bundle_paths，维护服务不导入 archive 私有实现。",
        "快照 storage 通过 storage.publication 的公开 identity reader 校验历史 release；纯 publication_identity 验证准确审核、事件、path/hash 和固定 renderer，无反向 application 依赖。",
        "check 不打开持久 archive Session。stage DB 使用共享 connect_database 配置且不创建邻接维护锁；恢复只改 staging，成功后才发布目标根。"
      ]
    },
    {
      "dot": "slate",
      "title": "完整条件与操作",
      "items": [
        "m1：共同步骤；CommandSpec 声明 save/restore MAINTENANCE；check 无档案连接；稳定锁位于根旁",
        "m2：共同步骤；选择 save/check/restore；服务库入口也独立取得维护访问",
        "m3：alt save；MAINTENANCE.access；排除全部 Session reader/writer/heartbeat；持锁直到安装结束",
        "m4：alt save；无 DDL 校验 schema/integrity/FK；拒绝有效 lease 的 running job",
        "m5：alt save；artifact_inventory.collect_artifacts；配置产物根优先，档案根回退；递归拒绝暂存、链接与碰撞",
        "m6：alt save；SQLite backup；有界 busy deadline；备份后再次校验 schema/FK 并拒绝活跃 job",
        "m7：alt save → loop archive.db 与全部已选物理产物；stream_hash 每次最多 1MiB；边写 ZIP 边 hash；读前/open/读后身份核对；每文件 size/SHA-256",
        "m8：alt save；required_artifacts；音频、成功 attempt、完整 bundle/marker、双稿、全部历史 release",
        "m9：alt save；加入 manifest；复核 ZIP 内全部 marker；fsync 后不覆盖安装到根外新目标",
        "m10：alt save；退出维护上下文；stage 清理；临时 DB 不建立持久锁文件",
        "m11：else check；严格 portable 路径、成员集合/size/hash、公共 bundle basenames/marker；仅提取临时 DB",
        "m12：else check；校验 snapshot contract 与所有 references；不创建持久档案，不刷新源 schema",
        "m13：else restore；MAINTENANCE.access 允许新目标；目标不存在或为空；稳定锁不随 rename 移动",
        "m14：else restore；ZIP 解包到 staging；校验全部 manifest/hash/marker/reference；通过后才允许恢复任务",
        "m15：else restore；running attempt failed/snapshot_restored；running job queued；清 lease；cancelled 保留",
        "m16：else restore；未完成 ingestion/acquisition 失败；未结束 model call 记录恢复原因；只改恢复 staging",
        "m17：else restore；再次 schema/FK 校验并 fsync",
        "m18：else restore；暂存 rename 为恢复 root；产物合并到恢复根；不覆盖旧档案",
        "m19：else restore；释放目标维护访问并清理 staging",
        "m20：共同步骤；返回快照或恢复统计；任一校验失败立即停止并释放已持访问"
      ]
    },
    {
      "dot": "amber",
      "title": "参与者内部动作",
      "items": [
        "数据库与身份：storage.publication.verify_release_identity 读取准确 edition/review/events；纯 publication_identity 验证历史 renderer"
      ]
    }
  ]
