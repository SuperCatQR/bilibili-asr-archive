  "cards": [
    {
      "dot": "cyan",
      "title": "条件与提交边界",
      "items": [
        "FTS 是 archive.db 内的派生表，不是单独搜索服务；只有显式构建或 --rebuild 写索引。",
        "每批 FTS 与精确进度一起提交，崩溃可从最后已提交 segment 恢复。",
        "metadata 使用当前 source tags；edition tags 为创建/显式同步时快照，二者不同。"
      ]
    },
    {
      "dot": "slate",
      "title": "阅读方法",
      "items": [
        "B 编号对应完整条件路径；互斥分支仅在条件成立时执行，opt 可选，loop 重复。",
        "HTML 将嵌套条件展开为连续区域；自调用保留在内部动作卡片。完整 Mermaid 与源码范围见同名 Markdown。"
      ]
    },
    {
      "dot": "amber",
      "title": "参与者内部动作",
      "items": [
        "时间轴步骤 2 · SQLite 与 FTS5：读取进度及新 segments。详细操作见同名 Markdown。",
        "时间轴步骤 3 · SQLite 与 FTS5：FTS 行与进度同提交。详细操作见同名 Markdown。",
        "时间轴步骤 6 · SQLite 与 FTS5：追加 MD fallback 行。详细操作见同名 Markdown。"
      ]
    },
    {
      "dot": "amber",
      "title": "完整条件路径",
      "items": [
        "B01（m1）：opt search-index 或 search --rebuild",
        "B02（m4–m5）：opt search-index 或 search --rebuild → opt 部分分 P 无持久 segments",
        "B03（m7）：opt search-index 或 search --rebuild",
        "B04（m9–m10）：opt metadata 或 all",
        "B05（m11）：opt transcripts 或 all",
        "B06（m12）：opt transcripts 或 all → alt 索引缺失或 all 无 FTS",
        "B07（m13）：opt transcripts 或 all → else 索引正常"
      ]
    }
