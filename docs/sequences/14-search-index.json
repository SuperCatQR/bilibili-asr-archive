  "cards": [
    {
      "dot": "cyan",
      "title": "分页与恢复",
      "items": [
        "构建先捕获 MAX transcript ID；(transcript_id,ordinal) keyset 每页最多 500，构建期间新采集留下一轮。",
        "内部动作：单行前瞻判定最后 segment；脱敏/CJK bigram；FTS 与精确 cursor 同提交，最后 segment 才推进完整水位。",
        "旧无 cursor 键保存在 SQLite 临时主键表，keyset 核对前缀、JOIN 标记既有 block；取消 O(index) Python 集合。",
        "只读旧 stamp 一次 materialized CTE 后流式核对，无 DDL；失败恢复已提交 cursor，不重写已有 block。"
      ]
    },
    {
      "dot": "rose",
      "title": "数据库与 MD 边界",
      "items": [
        "已有库 WRITE/NONE 加原 store 检查，只新增 FTS；新空 archive BOOTSTRAP；查询 READ/NONE + 索引形状检查。",
        "MD candidates 按 part ID/上界分页；连接临时主键表排除已有 MD，避免 Python 全集合与逐 part 扫描 FTS。",
        "READ 使用 mode=ro/query_only、无 DDL；读写连接均持有维护 lease 到 close。"
      ]
    },
    {
      "dot": "slate",
      "title": "组合查询",
      "items": [
        "metadata 使用当前 title/description/source tags，字面子串查询；不需 FTS、产物根或文件。",
        "transcripts 默认；all 中 metadata 优先、总 limit 共享，填满也检查转录源健康；缺索引可 backlog，损坏失败。",
        "UTC 日区间 [from,to+1day)；FTS pubdate 为构建快照，title/snippet 批量装饰；诊断与 JSON hits 分离。"
      ]
    }
  ]
