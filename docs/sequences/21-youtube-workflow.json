  "cards": [
    {
      "dot": "cyan",
      "title": "平台身份与数据边界",
      "items": [
        "仅单视频；播放列表、直播及不可信 URL 被拒绝。v2 存真实 platform / externalVideoId，YouTube 的 bvid/cid 为 NULL。",
        "发布日期只用明确 timestamp；只有 upload_date 时保持未知，不捏造午夜时间。",
        "yt-dlp/Deno 使用锁定依赖、有界进程、输出预算和 checkpoint；私有 cookie 路径只在运行环境，错误内容脱敏。"
      ]
    },
    {
      "dot": "amber",
      "title": "两条 producer 路径",
      "items": [
        "字幕优先考虑人工、非翻译、原语言候选；最多 32 项，保留 provenance，不自动翻译。",
        "ALL 直接建立 audio → ASR；BELOW_THRESHOLD 仅明确低质量才建立。字幕没有成为 audio 的依赖。",
        "匿名可见性、空正文与未知错误均不授予 Bilibili 的 credential_verified / absence_verified 权威。"
      ]
    },
    {
      "dot": "emerald",
      "title": "复用控制面与消费端",
      "items": [
        "采集、推理、publish 复用相同 job/attempt/lease 与心跳，长 I/O 不占权威写事务；陈旧 owner 无法提交。",
        "GPU 会话在隔离子进程执行；数据库与最终文件写入由父工作流持有围栏，CPU 保留现有路径。",
        "publish 是可变 transcript bundle；它不替代另行审核的 publication edition/release。",
        "neutral FTS 显式构建，metadata 查询和 JSON/CSV 保留真实源身份；快照保存数据库、五文件及 marker。"
      ]
    }
  ]
