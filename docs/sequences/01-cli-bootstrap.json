  "cards": [
    {
      "dot": "cyan",
      "title": "条件与提交边界",
      "items": [
        "status/runs 在库存在时仍使用初始化连接，并持有共享维护锁；workflow 查询也可初始化新库。",
        "共享 OS 维护锁只协调合作写入者与快照；SQLite BEGIN IMMEDIATE 决定事务写入顺序。",
        "注册表中共有 15 个顶层命令；旧版命令不能由源码中的历史 docstring 推断为当前入口。"
      ]
    },
    {
      "dot": "slate",
      "title": "阅读方法",
      "items": [
        "B 编号对应完整条件路径；互斥分支仅在条件成立时执行，opt 可选，loop 重复。",
        "HTML 将嵌套条件展开为连续区域；自调用保留在内部动作卡片。完整 Mermaid 与源码范围见同名 Markdown。"
      ]
    },
    {
      "dot": "amber",
      "title": "参与者内部动作",
      "items": [
        "时间轴步骤 4 · 路径与维护锁：选择并验证根。详细操作见同名 Markdown。",
        "时间轴步骤 8 · archive.db：初始化及刷新视图。详细操作见同名 Markdown。"
      ]
    },
    {
      "dot": "amber",
      "title": "完整条件路径",
      "items": [
        "B01（m2）：alt 无子命令或帮助请求",
        "B02（m3）：else 有效命令",
        "B03（m5）：else 有效命令 → opt 写归档或初始化查询",
        "B04（m6）：else 有效命令",
        "B05（m7）：else 有效命令 → alt 使用 open_database",
        "B06（m9）：else 有效命令 → alt 使用 open_database → alt 表契约兼容",
        "B07（m10）：else 有效命令 → alt 使用 open_database → else 不兼容",
        "B08（m11）：else 有效命令 → else 只读消费入口",
        "B09（m12–m14）：else 有效命令"
      ]
    }
