  "cards": [
    {"dot": "cyan", "title": "完整性与就绪度分开判断", "items": ["完整校验包括逐文件尺寸/摘要、便携路径、bundle 标记、数据库契约与外部产物引用。", "inspect/plan 临时提取 DB 以读取事实；不会创建或修改目标，原快照不被改写。", "任务状态由队列、依赖、available_at、取消、lease 和坏 payload 派生，不增加第二套持久状态。", "本机仅检查工具、包、设备、凭据名称与模型绑定；model_load_tested=false，凭据不代表在线验真。"]},
    {"dot": "emerald", "title": "恢复事务与报告", "items": ["仅暂存 DB：running job → queued；running attempt/ingestion/acquisition → failed；未完成模型调用被关闭。", "清除中断任务 lease 并加入 snapshot_recovery 证据；既有尝试计数、已完成与 cancelled 终态保留。", "可选报告逐行记录实体、identity、before、after、snapshot_id 和 reason，不复制原始秘密。", "报告必须是归档及原快照之外的新文件；碰撞或安装前写入失败时，目标归档不安装。"]},
    {"dot": "rose", "title": "安装后的真实结果", "items": ["restore 使用维护锁并再次验包/目标，不凭之前 plan_id 跳过校验，也不自动启动 worker。", "rename 后归档已安装；目录同步或审计追加失败以 installed=true 与 warnings 报告。", "doctor 只读校验安装后产物和任务事实；运行缺项需重新配置环境、凭据或显式模型 bindings。", "离线恢复不是生产切换或真实 GPU 验收；旧包格式保持原有版本。"]}
  ]
