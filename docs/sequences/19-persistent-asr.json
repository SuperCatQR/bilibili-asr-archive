  "cards": [
    {"dot": "cyan", "title": "执行身份与写入权限", "items": ["仅父进程持有 SQLite、续约和提交权限；GPU 子进程不连接数据库。", "IPC 比较 protocol、generation、request_id、job_id、owner、attempt、profile_digest 与 runtime_binding。", "超时、迟到响应、取消、失租和子进程错误均丢弃本次结果，并终止 Session 后重建。"]},
    {"dot": "emerald", "title": "热模型与有界准备", "items": ["会话按完整 ASR 配置与运行时模型绑定复用；配置或绑定改变先销毁旧会话。", "双轮推理重置任务热词与诊断；仅本次音频复用解码波形，不复用另一任务的 KV cache。", "CPU 预取默认关闭；开启后仅单层队列、独立 processor 与输入预算，失败回退串行。", "阶段 wall-time、父端等待和任务间隙是诊断证据，不能当作实测 GPU kernel 利用率。"]},
    {"dot": "rose", "title": "退出与平台范围", "items": ["Linux GPU 子进程建立新进程组并设置 prctl 父死信号；独立 EOF Guardian 清理解码后代。", "drain 停止领取新任务，活动任务继续续约；宽限期到达后 checkpoint 中止本次推理。", "oneshot 为回退方式；图示持久 GPU 分支，CPU 与 legacy 路径见实现文档。", "本地 WSL 故障测试支持这些控制语义；图不代表真实 GPU 性能或 Windows 全进程树已经验收。"]}
  ]
