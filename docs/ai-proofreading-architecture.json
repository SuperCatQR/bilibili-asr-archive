  "cards": [
    {
      "dot": "cyan",
      "title": "采集与原始发布",
      "items": [
        "字幕独立；ASR 仅依赖音频，不因已有字幕省略",
        "字幕或 ASR 写入受租约保护，取消后可收尾 failed run",
        "原始发布独立于校对：SRT / VTT / TXT / MD / JSON"
      ]
    },
    {
      "dot": "amber",
      "title": "校对与文档",
      "items": [
        "冻结精确 ASR 结果，可引用同分 P、同语言字幕",
        "分块和 revision 校验通过后，在 owned guard 内提交",
        "reading.md 仅正文；review.md 保存对照、疑点与血缘",
        "结构校验不是语义保真证明，AI 整理稿仍需人工审核"
      ]
    },
    {
      "dot": "violet",
      "title": "取消与提交边界",
      "items": [
        "取消 queued 无伪 attempt；running 关闭 attempt 并撤销 lease",
        "网络与模型调用协作停止，响应审计可以保留",
        "取消先提交会拒绝迟到内容；先提交的结果保留",
        "cancelled 不被 retry、重复 plan 或重发复活；后继阻塞"
      ]
    },
    {
      "dot": "emerald",
      "title": "产物与持久证据",
      "items": [
        "SQLite 表为同一 archive.db 的逻辑分区",
        "原始五产物、marker 与发布登记共用短写锁",
        "发布失败失效 marker；SQLite 与文件系统不是回滚整体",
        "校对 revision 与阅读文档独立，不覆盖原始转录"
      ]
    }
  ]
