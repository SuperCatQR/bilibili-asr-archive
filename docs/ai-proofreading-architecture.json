  "cards": [
    {
      "dot": "cyan",
      "title": "独立不可变层",
      "items": [
        "原始转录 → 固定 input → AI revision → 完整 edition；每层保留精确来源身份。",
        "原始转录 bundle 独立发布；本图聚焦 AI 与人工出版，不把它串成校对 prerequisite。",
        "render 重用保存 revision；读取历史模板按保存版本的固定 renderer 验证。"
      ]
    },
    {
      "dot": "emerald",
      "title": "三种选择规则",
      "items": [
        "公开：仅 current_release_id 指向的有效 release + 配对原始 review.md。",
        "预览：仅 current_edition_id 指向、且从未产生任何状态 release 的 edition。",
        "私有：显式 revision/edition，含 AI 双稿、全内容差异、审核 events 和冻结配置。"
      ]
    },
    {
      "dot": "rose",
      "title": "审核与恢复",
      "items": [
        "审核比对 edition、完整内容 SHA 与 expected status；approved 不自动公开。",
        "新 draft/approved B 不影响有效 A；显式 publish B 才替换；withdraw 清公开 head。",
        "块提交、revision 与 AI 双稿受 lease/cancel 保护；输出目录是独立锁和恢复协议。",
        "校对固定输入与任务/绑定共同提交；共享 JobCommitGuard 保护所有派生持久化，不临时创建调度仓库。",
        "双稿编码、暂存写入与文件 fsync 在事务外；事务内安装不可变文件并登记，失败留下可验证、可重试的未登记字节。"
      ]
    },
    {
      "dot": "amber",
      "title": "当前来源与消费扩展",
      "items": [
        "保留旧正文不重跑 AI；标题或简介补充各有不可变证据，并创建需要重新审核的 content v2 子版。",
        "准确历史双稿可通过 artifact catalog 保留或恢复；当前可变槽位不是旧版本。",
        "普通/迁移 origin 导出与可选编辑确认 series 各有离线 Schema 和实际身份校验。"
      ]
    },
    {
      "dot": "amber",
      "title": "简介补充与消费者边界",
      "items": [
        "仅已 import-preserved 且简介未知的历史 v2 文章可补；原生 v2 跳过，已有另一字段补充的版本阻止操作。",
        "plan 从已存 video_details 读取真实简介；apply 在同一事务复验来源证据、正文 hash 和 draft/release heads。",
        "简介不替换编辑摘要；正文 UTF-8 字节与固定 AI 双稿保留，旧正式发布继续有效。",
        "universal-origin-v2：catalog 3、origins 2、manifest 3、source-metadata 1；旧 profile 保持并拒绝新简介补充。",
        "当前 Reader 只支持 universal-origin-v1；新 profile 消费者升级属于后续工作。"
      ]
    }
  ]
