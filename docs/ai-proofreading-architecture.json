  "cards": [
    {
      "dot": "cyan",
      "title": "现有采集边界",
      "items": [
        "字幕与音频是独立任务，ASR 仅依赖音频",
        "原始归档不等待校对；字幕存在不抑制 ASR"
      ]
    },
    {
      "dot": "amber",
      "title": "校对与文档边界",
      "items": [
        "proofread 与 render_document 复用同一执行器",
        "疑点单独列入 review.md，reading.md 只有正文",
        "结构校验可追溯来源，语义保真仍需人工审核"
      ]
    },
    {
      "dot": "violet",
      "title": "持久化与证据",
      "items": [
        "三组 SQLite 表是一个数据库的逻辑分区",
        "原始转录、校对版本、阅读文档各有血缘",
        "模型调用、分块检查点和来源快照持久化保存"
      ]
    }
