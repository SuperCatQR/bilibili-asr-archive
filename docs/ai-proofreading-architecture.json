  "cards": [
    {
      "dot": "cyan",
      "title": "现有采集边界",
      "items": [
        "字幕与音频是独立任务，ASR 仅依赖音频",
        "原始归档不等待校对；字幕存在不抑制 ASR"
      ]
    },
    {
      "dot": "amber",
      "title": "校对与文档边界",
      "items": [
        "proofread 与 render_document 复用同一执行器",
        "ai-draft.md 为纯正文，疑点仅写入 review.md",
        "结构校验能追溯来源，语义保真仍需人工审核"
      ]
    },
    {
      "dot": "violet",
      "title": "持久化与证据",
      "items": [
        "三组 SQLite 表是一个数据库的逻辑分区",
        "原始转录、校对版本、阅读文档各有血缘",
        "模型调用、分块检查点和来源快照持久化保存"
      ]
    },
    {
      "dot": "emerald",
      "title": "准确审核与公开边界",
      "items": [
        "完整内容哈希覆盖标题、正文、摘要、来源、标签与说明",
        "创建、拒绝或批准 B 都不改变已发布 A，显式 publish 才切换",
        "withdraw 清空有效指针；公开导出不包含 review.md 或模型审计"
      ]
    }
  ]
}
