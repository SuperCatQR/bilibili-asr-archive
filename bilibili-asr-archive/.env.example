# Bilibili Session Cookie (for accessing member-only subtitles)
# Get this from your browser's developer tools after logging in
# BILI_SESSDATA=your_sessdata_cookie_value_here

# ASR Model Configuration
# Default: FunAudioLLM/Fun-ASR-Nano-2512
# BILI_ASR_MODEL=FunAudioLLM/Fun-ASR-Nano-2512

# ASR Device
# Options: cuda (GPU), cpu
# Default: cuda
# BILI_ASR_DEVICE=cuda

# Audio Retention Policy
# Set to 1 to keep audio files after archival (for future reprocessing)
# Default: 0 (audio deleted after archived status to save disk space)
BILI_KEEP_AUDIO=1
