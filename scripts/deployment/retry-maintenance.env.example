# Reviewed deployment paths; no model/network credentials are needed for maintenance.
BILI_ASR_BIN=/opt/bili-asr/.venv/bin/bili-asr
ARCHIVE_ROOT=/srv/bilibili/archive
RETRY_POLICY=/etc/bili-asr/retry-policy.json
PRODUCTION_STATE=/srv/bilibili/production-ops/state.json
MAINTENANCE_LOCK=/srv/bilibili/production-ops/maintenance.lock
MAINTENANCE_HEALTH=/srv/bilibili/production-ops/retry-maintenance-health.json
