# Morning Star harness (.mstar/)
.mstar/**
!.mstar/AGENTS.md
!.mstar/knowledge/
!.mstar/knowledge/**
!.mstar/specs/
!.mstar/specs/**
# Iteration contract drafts only (compass D11): the process face — package
# README, delivery-compass.md, iterations/README.md, guides/ — stays local.
# The three parent re-includes must precede the leaf: git cannot re-include a
# path whose parent directory is still excluded.
!.mstar/iterations/
!.mstar/iterations/*/
!.mstar/iterations/*/specs/
!.mstar/iterations/*/specs/**
# runtime / media
bilibili-asr-archive/archive/audio/
bilibili-asr-archive/archive/transcripts/
bilibili-asr-archive/logs/
# local ASR checkpoints: multi-GB operator-downloaded weights, never tracked
bilibili-asr-archive/models/
__pycache__/
*.pyc
.venv/
venv/
.env
*.m4a
*.wav

# editor / scratch leftovers
*.swp
*.swo

.worktrees/
.tmp/
.tmp2/
pydiagout.txt
bilibili-asr-archive/.test-tmp/
bilibili-asr-archive/.pytest-*/
bilibili-asr-archive/.tb/
bilibili-asr-archive/.pfx*/
bilibili-asr-archive/.pydel*/
bilibili-asr-archive/pip-*/
bilibili-asr-archive/pytest-cache-files-*/
