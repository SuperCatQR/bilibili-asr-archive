+        "last_api_error_code": None,
+        "updated_at": utc_now_iso(),
+    }
+    rec = build_run_record(
+        command="fetch-meta",
+        started_at="2026-08-25T10:00:00Z",
+        finished_at="2026-08-25T10:01:00Z",
+        exit_code=0,
