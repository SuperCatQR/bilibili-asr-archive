+            "finger/spi": [SPI_OK],
+            "nav": [nav_ok(), nav_response()],
+            "player/wbi/v2": [player_ok([sub_entry()]), player_ok([])],
+            "aisubtitle.hdslb.com": [(200, dict(SAMPLE_DOC))],
+            "/x/player/wbi/playurl": [playurl_ok()],
